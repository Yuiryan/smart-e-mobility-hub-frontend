# Public build-time variables: NEVER put secrets in VITE_*.
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api
# Development proxy only; not bundled into browser JavaScript.
API_PROXY_TARGET=http://localhost:8080
# Backend DTO: fullName on registration and role on login.
VITE_AUTH_PROFILE=backend
# IoT demo proxy only (npm run dev:iot-demo, frontend 5174 -> backend 8081).
IOT_DEMO_API_PROXY_TARGET=http://localhost:8081
